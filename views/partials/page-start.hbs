<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/logo.svg">
  <title>{{title}} — Film Tinder</title>
  <style>
    :root{font-family:Inter,system-ui,sans-serif;color:#f4f4f5;background:#09090b}body{margin:0}.shell{max-width:1100px;margin:auto;padding:24px}.header{border-bottom:1px solid #27272a;background:#18181b}.header .shell,.row{display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{color:#ef4444;font-weight:900;text-decoration:none;font-size:22px}.menu{display:flex;gap:16px}.menu a,a{color:#f4f4f5}.muted{color:#a1a1aa}.card{background:#18181b;border:1px solid #27272a;border-radius:16px;padding:16px;margin:12px 0}.button,button{display:inline-block;border:0;border-radius:10px;padding:10px 14px;background:#e50914;color:#fff;font-weight:700;text-decoration:none;cursor:pointer}.button.secondary{background:#3f3f46}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}label{display:block;margin:14px 0 6px;color:#d4d4d8}input,textarea{box-sizing:border-box;width:100%;padding:11px;border-radius:9px;border:1px solid #3f3f46;background:#18181b;color:#fff}textarea{min-height:120px}.footer{border-top:1px solid #27272a;color:#71717a;margin-top:30px}.notice{padding:10px 14px;border-radius:10px;background:#3f3f46;display:none;position:sticky;top:8px;z-index:2}.session{display:flex;align-items:center;gap:12px}.logout{margin:0}
  </style>
</head>
<body>
  {{> header}}
  <main class="shell">
    <div id="live-notice" class="notice"></div>
