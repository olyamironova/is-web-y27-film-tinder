{{> page_start}}
<h1>{{title}}</h1>
<form class="card" method="post" action="{{action}}">
  <label for="title">Название</label><input id="title" name="title" value="{{movie.title}}" required maxlength="200">
  <label for="description">Описание</label><textarea id="description" name="description" required>{{movie.description}}</textarea>
  <label for="posterUrl">URL постера</label><input id="posterUrl" name="posterUrl" value="{{movie.posterUrl}}" required>
  <label for="backdropUrl">URL фона</label><input id="backdropUrl" name="backdropUrl" value="{{movie.backdropUrl}}" required>
  <label for="rating">Рейтинг</label><input id="rating" name="rating" type="number" step="0.1" min="0" max="10" value="{{movie.rating}}" required>
  <label for="year">Год</label><input id="year" name="year" type="number" min="1888" max="2100" value="{{movie.year}}" required>
  <label for="genres">Жанры через запятую</label><input id="genres" name="genres" value="{{movie.genresCsv}}" required>
  <label for="director">Режиссёр</label><input id="director" name="director" value="{{movie.director}}" required>
  <label for="cast">Актёры через запятую</label><input id="cast" name="cast" value="{{movie.castCsv}}">
  <p><button type="submit">Сохранить</button> <a class="button secondary" href="/admin/movies">Отмена</a></p>
</form>
{{> page_end}}
