{
  "name": "film-tinder",
  "private": true,
  "version": "1.0.0",
  "description": "Film Tinder full-stack application (React + NestJS)",
  "author": "Olga Mironova",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsc-watch --project tsconfig.server.json --onSuccess \"node --enable-source-maps dist/server/main.js\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "start:prod": "node dist/server/main.js",
    "start:dev": "tsc-watch --project tsconfig.server.json --onSuccess \"node --enable-source-maps dist/server/main.js\"",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "framer-motion": "^12.23.26",
    "graphql": "^16.14.2",
    "graphql-query-complexity": "^2.0.0",
    "hbs": "^4.3.0",
    "lucide-react": "^0.562.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertokens-node": "^24.0.3",
    "tailwind-merge": "^3.4.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.5.1",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^30.5.1",
    "pg-mem": "^3.0.14",
    "postcss": "^8.5.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
